{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/prm"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/prm-mcp"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 120
    }
  }
}
